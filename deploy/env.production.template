# TradingAgents-CN 生产环境变量配置
# ⚠️ 此文件由 setup.sh 自动生成，请勿手动提交到 Git
# 如需修改，请在服务器上编辑 /opt/tradingagents/worktree/.env

# ==================== 数据库配置 ====================
# ⚠️ 密码必须与 docker-compose 中 MONGO_INITDB_ROOT_PASSWORD / redis requirepass 一致
# 默认使用 tradingagents123，如需修改请同时修改 compose 文件和此处
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=tradingagents123
MONGODB_DATABASE=tradingagentscn
MONGODB_AUTH_SOURCE=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=tradingagents123
REDIS_DB=0

# ==================== 安全配置 ====================
JWT_SECRET={{JWT_SECRET}}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
CSRF_SECRET={{CSRF_SECRET}}
BCRYPT_ROUNDS=12

# ==================== CORS 配置 ====================
CORS_ORIGINS=*

# ==================== AI 模型 API 密钥 ====================
# ⚠️ 部署后请在服务器上编辑 .env 填入真实密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_ENABLED=false

DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_ENABLED=false

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENABLED=false

GOOGLE_API_KEY=
GOOGLE_ENABLED=false

BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ENABLED=false

OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false

AIHUBMIX_API_KEY=
AIHUBMIX_ENABLED=false

SILICONFLOW_API_KEY=
SILICONFLOW_ENABLED=false

VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ==================== 数据源配置 ====================
DEFAULT_CHINA_DATA_SOURCE=akshare
AKSHARE_ENABLED=true
BAOSTOCK_ENABLED=true

TUSHARE_TOKEN=
TUSHARE_ENABLED=false

FINNHUB_API_KEY=
FINNHUB_ENABLED=false

# ==================== 日志配置 ====================
TRADINGAGENTS_LOG_LEVEL=INFO
TRADINGAGENTS_LOG_DIR=/app/logs
TRADINGAGENTS_LOG_FILE=/app/logs/tradingagents.log

# ==================== Docker 标识 ====================
DOCKER_CONTAINER=true

# ==================== Webhook 配置 ====================
WEBHOOK_SECRET={{WEBHOOK_SECRET}}
