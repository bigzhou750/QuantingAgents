# zhitouagent 生产环境变量配置
# ⚠️ 此文件由 setup.sh 自动生成，请勿手动提交到 Git
# 如需修改，请在服务器上编辑 /opt/zhitouagent/worktree/.env

# ==================== 数据库配置 ====================
# ⚠️ 密码由 setup.sh 随机生成，不得提交到 Git
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD={{MONGODB_PASSWORD}}
MONGODB_DATABASE=zhitouagent
MONGODB_AUTH_SOURCE=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{REDIS_PASSWORD}}
REDIS_DB=0

# ==================== 安全配置 ====================
JWT_SECRET={{JWT_SECRET}}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
CSRF_SECRET={{CSRF_SECRET}}
BCRYPT_ROUNDS=12
DEBUG=false
AUTH_REGISTRATION_ENABLED=true

# ==================== CORS 配置 ====================
ALLOWED_ORIGINS={{ALLOWED_ORIGINS}}
ALLOWED_HOSTS={{ALLOWED_HOSTS}}

# ==================== AI 模型 API 密钥 ====================
DEEPSEEK_API_KEY={{DEEPSEEK_API_KEY}}
DEEPSEEK_ENABLED=true

# 管理员初始化密码，生产环境建议通过安全渠道设置后再启动
INITIAL_ADMIN_PASSWORD=

# ==================== 数据源配置 ====================
DEFAULT_CHINA_DATA_SOURCE=akshare
AKSHARE_ENABLED=true
BAOSTOCK_ENABLED=true

TUSHARE_TOKEN=
TUSHARE_ENABLED=false

FINNHUB_API_KEY=
FINNHUB_ENABLED=false

# ==================== 日志配置 ====================
ZHITOUAGENT_LOG_LEVEL=INFO
ZHITOUAGENT_LOG_DIR=/app/logs
ZHITOUAGENT_LOG_FILE=/app/logs/zhitouagent.log

# ==================== Docker 标识 ====================
DOCKER_CONTAINER=true

# ==================== Webhook 配置 ====================
WEBHOOK_SECRET={{WEBHOOK_SECRET}}
